anchor=top-right
default-timeout=4000
margin=6,6,6,6
border-size=2
outer-margin=20
padding=10,15
max-icon-size=32
font=sans-serif 14px
format=<span line_height="1.2"><b>%s</b>\n%b</span>

background-color=#24273a
text-color=#cad3f5
border-color=#8aadf4
progress-color=over #363a4f

[urgency=high]
border-color=#f5a97f

[app-name=state]
default-timeout=500

[app-name=Spotify]
invisible=1

[mode=do-not-disturb]
invisible=true

[mode=do-not-disturb app-name=notify-send]
invisible=false

[urgency=critical]
default-timeout=0


