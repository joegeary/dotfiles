[Unit]
Description=Zoom Team Chat -> notify-send daemon
Documentation=https://developers.zoom.us/docs/api/websockets/
# Wait for a notification daemon + graphical session to be up.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
EnvironmentFile=%h/.config/zoom-chat-notifier/env
ExecStart=%h/.local/share/zoom-chat-notifier/venv/bin/python %h/.local/bin/zoom-chat-notifier
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target
