# Copy to `env` (same dir) and fill in. The real `env` is gitignored.
# systemd reads this via EnvironmentFile= -- KEY=value, no `export`, no quotes needed.

# "s2s"  = Server-to-Server OAuth app (requires Zoom account admin)
# "oauth" = user-managed OAuth "General" app (no admin; run --authorize once)
ZOOM_AUTH_MODE=s2s

# From the Marketplace app's "App Credentials" page:
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# From the app's "Event Subscriptions" (WebSocket) section:
ZOOM_SUBSCRIPTION_ID=

# --- s2s mode only ---
ZOOM_ACCOUNT_ID=

# --- oauth mode only ---
# Must exactly match a Redirect URL on the app. Zoom requires https:// (http
# is rejected with error 4700). Nothing actually needs to listen there -- the
# --authorize flow has you paste the code out of the browser address bar.
#ZOOM_REDIRECT_URI=https://localhost:8723/callback

# Optional: skip notifications for messages you sent yourself.
ZOOM_MY_EMAIL=jgeary@oncoursesystems.com

# Optional: icon for the popup (name from your icon theme, or an absolute path).
ZOOM_NOTIFY_ICON=zoom
