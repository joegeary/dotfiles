#!/usr/bin/env bash

# XDG base directories
export XDG_CONFIG_HOME=$HOME/.config
export XDG_CACHE_HOME=$HOME/.cache
export XDG_DATA_HOME=$HOME/.local/share
export XDG_STATE_HOME=$HOME/.local/state

export PAGER=less

# tuxedo / todo.txt-cli: load todos from ~/.todo/todo.txt
export TODO_DIR="$HOME/.todo"

# PATH
export PATH=$HOME/.cargo/bin:$PATH      # Rust programs
export PATH=$HOME/.dotnet/tools:$PATH   # Dotnet global tools
export PATH=$HOME/.local/bin:$PATH      # User installed programs
export PATH=$HOME/.local/scripts:$PATH  # User scripts
export PATH=$HOME/.npm-global/bin:$PATH # Global npm packages
export PATH=$HOME/.aspire/bin:$PATH
export PATH=$HOME/bin/Sencha/Cmd/7.9.0.35:$PATH

# Set Neovim as default editor
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vim'
else
  export EDITOR='nvim'
fi

# Set default browser
export BROWSER='firefox'

# Use Neovim as man pager
export MANPAGER="nvim +Man!"
export MANWIDTH=99

# Customize spelling correction prompt
export SPROMPT="zsh: correct %F{red}%R%f to %F{green}%r%f [nyae]?"

# Remove / from WORDCHARS
export WORDCHARS=${WORDCHARS//[\/]/}

# less
export LESSOPEN="| highlight %s -O truecolor -s darkplus --force -l"
export LESS="-R -M -i -j5"

# gpg-agent
export GPG_TTY=$(tty)

# import any variables in the ~/.zprofile (not checked into source control)
if [ -f "$HOME/.zprofile" ]; then
  source $HOME/.zprofile
fi
