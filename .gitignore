# Direnv files
.envrc

# Git-crypt keys
.keys/

# Python cache files
__pycache__
*.py[cod]
*$py.class

# Todo file
TODO

# Log files
*.log

# Personal files
.config/git/config-*

# Zsh completion cache (regenerated on login)
.zcompdump*

# Yazi temp/backup files
.config/yazi/*.toml-*

# tmux plugins (managed by TPM at ~/.tmux/plugins)
.config/tmux/plugins/

# Claude Code: track shared settings.json; ignore machine-local overrides
.claude/settings.local.json

# Noctalia: track settings.json (durable config); ignore generated/runtime files
.config/noctalia/colors.json
.config/noctalia/colorschemes/
# Ignore downloaded registry plugins, but track our own authored plugin(s)
.config/noctalia/plugins/*
!.config/noctalia/plugins/onair-hue/

# Herdr: track config.toml only; everything else is runtime (logs, sockets,
# session layout, cached release notes) and must never be committed
.config/herdr/*
!.config/herdr/config.toml
