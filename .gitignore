# Direnv
.envrc

# Python cache
__pycache__
*.py[cod]
*$py.class

# Logs
*.log

# Personal git config split out of the tracked one
home/.config/git/config-*

# Zsh completion cache (regenerated on login)
home/.config/zsh/.zcompdump*

# Yazi temp/backup files
home/.config/yazi/*.toml-*

# tmux plugins (managed by TPM at ~/.tmux/plugins)
home/.config/tmux/plugins/

# Claude Code: track shared settings.json; ignore machine-local overrides
home/.claude/settings.local.json

# Herdr: track config.toml only; everything else is runtime (logs, sockets,
# session layout, cached release notes) and must never be committed
home/.config/herdr/*
!home/.config/herdr/config.toml

# k9s rewrites config.yaml at runtime with the live cluster/context name.
# Since ~/.config/k9s is a symlink into this repo and this repo is public, that
# would publish real cluster names. Track aliases/plugins/skin only.
home/.config/k9s/config.yaml

# leaf writes history.toml next to its config, holding the absolute path of
# every file opened. ~/.config/leaf is a folded symlink into this repo, so that
# lands here - and this repo is public. Track config.toml only.
home/.config/leaf/*
!home/.config/leaf/config.toml

# wayscriber writes a timestamped .bak beside config.toml every time a shortcut
# is recorded, and ~/.config/wayscriber is a folded symlink into this repo.
# Track config.toml only.
home/.config/wayscriber/*
!home/.config/wayscriber/config.toml

# OpenLogi keeps lock files, overlay.claim and rotating config.toml.backup.N
# copies beside its config. ~/.config/openlogi is a folded symlink into this
# repo because the app saves by atomic rename, which would replace a symlinked
# file with a regular one. Track config.toml only.
hosts/sigint/.config/openlogi/*
!hosts/sigint/.config/openlogi/config.toml

# Package delta files generated by os-migration/restore-packages.sh
os-migration/delta-*.txt
