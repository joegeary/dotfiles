#!/usr/bin/env python3
"""
auto-clicker — a human-ish auto-clicker for Hyprland/Wayland.

Creates a *real* kernel input device via uinput (indistinguishable from
hardware on the evdev path), so it's low-profile AND lets you keep using your
physical mouse at the same time. Aiming is closed-loop off `hyprctl cursorpos`,
so pointer acceleration can't throw off the target.

Anti-pattern-detection measures:
  * device masquerades as a generic Logitech USB Optical Mouse (vid/pid 046d:c077)
    with a full button + wheel capability set
  * click intervals are continuous, Gaussian within the band, with occasional
    longer "distraction" pauses (kills regular-cadence detection)
  * click position is Gaussian-jittered a couple px around the spot every time
  * eased travel with slight path wobble; randomized hold-time and step timing

USAGE
  auto-clicker set-spot [--delay N]   Capture the click target (aim mouse, wait N sec)
  auto-clicker stay                   Toggle "jump & stay" mode  (auto-starts daemon)
  auto-clicker return                 Toggle "jump, click, snap back" mode
  auto-clicker stop                   Stop clicking / kill daemon
  auto-clicker status                 Show daemon + config state
  auto-clicker daemon [--start-mode idle|stay|return]   (run by the toggles)

Config: ~/.config/auto-clicker/config.json  (edit interval/jitter knobs there)
"""

import argparse
import json
import math
import os
import random
import signal
import subprocess
import sys
import time
from pathlib import Path

CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "auto-clicker"
CONFIG_FILE = CONFIG_DIR / "config.json"
PID_FILE = CONFIG_DIR / "daemon.pid"

DEFAULTS = {
    "x": None,                       # target screen coords (global, Hyprland space)
    "y": None,
    "interval_min": 3.0,             # seconds between clicks (Gaussian within band)
    "interval_max": 4.0,
    "long_pause_dur": [30.0, 60.0],      # a long "AFK" sit lasts this many seconds
    "long_pause_gap": [1800.0, 3600.0],  # seconds between sits (30-60min => ~1-2/hr)
    "pos_jitter_px": 2.0,            # stddev of position jitter around the spot
    "click_hold_ms": [45, 110],      # press->release hold time range
    "settle_ms": [25, 90],           # pause after arriving, before pressing
    "first_delay": [0.4, 1.4],       # delay before the very first click
}

# ---------------------------------------------------------------------------
# small helpers
# ---------------------------------------------------------------------------

def load_config():
    cfg = dict(DEFAULTS)
    if CONFIG_FILE.exists():
        try:
            cfg.update(json.loads(CONFIG_FILE.read_text()))
        except Exception:
            pass
    return cfg


def save_config(cfg):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_FILE.write_text(json.dumps(cfg, indent=2))


def notify(summary, body=""):
    try:
        subprocess.run(["notify-send", "-a", "auto-clicker", summary, body],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
    except Exception:
        pass


def cursorpos():
    """Current global cursor position via Hyprland, or None."""
    try:
        out = subprocess.run(["hyprctl", "cursorpos"], capture_output=True,
                             text=True, timeout=1).stdout.strip()
        x, y = out.split(",")
        return float(x), float(y)
    except Exception:
        return None


def read_pid():
    try:
        pid = int(PID_FILE.read_text().strip())
        os.kill(pid, 0)          # raises if not alive
        return pid
    except Exception:
        return None


def rand_ms(rng):
    return random.uniform(rng[0], rng[1]) / 1000.0


# ---------------------------------------------------------------------------
# the daemon
# ---------------------------------------------------------------------------

STATE = {"mode": None}   # None = idle, "stay", or "return"
STOP = {"flag": False}


def make_device():
    from evdev import UInput, ecodes as e
    # Full 3-button + wheel capability set so it reads like a normal mouse.
    cap = {
        e.EV_KEY: [e.BTN_LEFT, e.BTN_RIGHT, e.BTN_MIDDLE],
        e.EV_REL: [e.REL_X, e.REL_Y, e.REL_WHEEL, e.REL_HWHEEL],
    }
    return UInput(cap, name="Logitech USB Optical Mouse",
                  vendor=0x046d, product=0xc077, version=0x0111,
                  bustype=e.BUS_USB)


def emit_rel(ui, dx, dy):
    from evdev import ecodes as e
    if dx:
        ui.write(e.EV_REL, e.REL_X, int(dx))
    if dy:
        ui.write(e.EV_REL, e.REL_Y, int(dy))
    ui.syn()


def move_to(ui, tx, ty):
    """Closed-loop move to (tx, ty): nudge, re-read, correct. Eased + wobbly."""
    for _ in range(120):
        cur = cursorpos()
        if cur is None:
            return
        dx, dy = tx - cur[0], ty - cur[1]
        dist = math.hypot(dx, dy)
        if dist <= 1.5:
            return
        ux, uy = dx / dist, dy / dist
        cap = min(60.0, dist * 0.35 + 1.0)        # exponential ease-out
        mvx, mvy = ux * cap, uy * cap
        if dist > 6:                               # fading perpendicular wobble
            wob = random.gauss(0, min(1.2, dist * 0.03))
            mvx += -uy * wob
            mvy += ux * wob
        ix, iy = round(mvx), round(mvy)
        if ix == 0 and iy == 0:                    # guarantee progress
            ix = 1 if dx > 0 else -1
        emit_rel(ui, ix, iy)
        time.sleep(max(0.002, random.gauss(0.008, 0.003)))


def do_click(ui, cfg, mode):
    from evdev import ecodes as e
    origin = cursorpos()
    if origin is None or cfg["x"] is None:
        return
    tx = cfg["x"] + random.gauss(0, cfg["pos_jitter_px"])
    ty = cfg["y"] + random.gauss(0, cfg["pos_jitter_px"])
    move_to(ui, tx, ty)
    time.sleep(rand_ms(cfg["settle_ms"]))
    ui.write(e.EV_KEY, e.BTN_LEFT, 1); ui.syn()
    time.sleep(rand_ms(cfg["click_hold_ms"]))
    ui.write(e.EV_KEY, e.BTN_LEFT, 0); ui.syn()
    if mode == "return":
        time.sleep(rand_ms([20, 60]))
        move_to(ui, origin[0] + random.gauss(0, 1), origin[1] + random.gauss(0, 1))


def next_interval(cfg):
    lo, hi = cfg["interval_min"], cfg["interval_max"]
    mid, sd = (lo + hi) / 2.0, (hi - lo) / 4.0
    return min(hi, max(lo, random.gauss(mid, sd)))


def long_gap(cfg):
    """Seconds to wait before the next long AFK sit."""
    return random.uniform(*cfg["long_pause_gap"])


def long_dur(cfg):
    """How long a single AFK sit lasts."""
    return random.uniform(*cfg["long_pause_dur"])


def interruptible_sleep(seconds):
    """Sleep, but bail early if we're stopped or the mode is turned off."""
    slept = 0.0
    while slept < seconds and not STOP["flag"] and STATE["mode"] is not None:
        time.sleep(0.1)
        slept += 0.1


def set_mode(m):
    if STATE["mode"] == m:
        STATE["mode"] = None
        notify("Auto-clicker paused")
    else:
        first = STATE["mode"] is None
        STATE["mode"] = m
        notify(f"Auto-clicker: {m} mode", "running" if first else "switched")


def run_daemon(start_mode):
    if read_pid():
        return  # already running; the toggles will just signal it
    cfg = load_config()
    if cfg["x"] is None:
        notify("auto-clicker: no spot set", "Run `auto-clicker set-spot` first")
        sys.exit(1)

    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    PID_FILE.write_text(str(os.getpid()))

    def cleanup(*_):
        STOP["flag"] = True
    signal.signal(signal.SIGUSR1, lambda *_: set_mode("stay"))
    signal.signal(signal.SIGUSR2, lambda *_: set_mode("return"))
    signal.signal(signal.SIGHUP, lambda *_: cfg.update(load_config()))
    signal.signal(signal.SIGTERM, cleanup)
    signal.signal(signal.SIGINT, cleanup)

    ui = make_device()
    time.sleep(0.3)  # let the compositor enumerate the new device

    if start_mode in ("stay", "return"):
        set_mode(start_mode)
        time.sleep(random.uniform(*cfg["first_delay"]))

    try:
        next_long = None
        while not STOP["flag"]:
            mode = STATE["mode"]
            if mode is None:
                next_long = None          # reset the break schedule while paused
                time.sleep(0.15)
                continue
            if next_long is None:
                next_long = time.monotonic() + long_gap(cfg)
            if time.monotonic() >= next_long:      # time for an AFK sit
                dur = long_dur(cfg)
                notify("Auto-clicker: taking a break", f"~{int(dur)}s")
                interruptible_sleep(dur)
                next_long = time.monotonic() + long_gap(cfg)
                continue
            do_click(ui, cfg, mode)
            interruptible_sleep(next_interval(cfg))
    finally:
        ui.close()
        try:
            PID_FILE.unlink()
        except FileNotFoundError:
            pass
        notify("Auto-clicker stopped")


# ---------------------------------------------------------------------------
# client subcommands (run by hotkeys / you)
# ---------------------------------------------------------------------------

def spawn_or_signal(mode):
    cfg = load_config()
    if cfg["x"] is None:
        notify("auto-clicker: no spot set", "Run `auto-clicker set-spot` first")
        return
    pid = read_pid()
    sig = signal.SIGUSR1 if mode == "stay" else signal.SIGUSR2
    if pid:
        os.kill(pid, sig)
    else:
        subprocess.Popen([sys.executable, os.path.abspath(__file__),
                          "daemon", "--start-mode", mode],
                         start_new_session=True, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def cmd_stop():
    pid = read_pid()
    if pid:
        os.kill(pid, signal.SIGTERM)
    else:
        notify("Auto-clicker not running")


def cmd_set_spot(delay):
    notify("auto-clicker", f"Aim your mouse at the target — capturing in {delay:g}s")
    time.sleep(delay)
    pos = cursorpos()
    if pos is None:
        print("Could not read cursor position (is Hyprland running?)", file=sys.stderr)
        sys.exit(1)
    cfg = load_config()
    cfg["x"], cfg["y"] = round(pos[0], 1), round(pos[1], 1)
    save_config(cfg)
    msg = f"Spot set to ({cfg['x']}, {cfg['y']})"
    print(msg)
    notify("auto-clicker", msg)
    if read_pid():
        os.kill(read_pid(), signal.SIGHUP)  # live-reload if daemon is up


def cmd_status():
    cfg = load_config()
    pid = read_pid()
    print(f"daemon : {'running (pid %d)' % pid if pid else 'stopped'}")
    print(f"spot   : ({cfg['x']}, {cfg['y']})" if cfg["x"] is not None else "spot   : NOT SET")
    print(f"interval: {cfg['interval_min']}-{cfg['interval_max']}s  jitter: {cfg['pos_jitter_px']}px")
    lg, ld = cfg["long_pause_gap"], cfg["long_pause_dur"]
    print(f"breaks : {ld[0]:g}-{ld[1]:g}s sit every {lg[0]/60:g}-{lg[1]/60:g} min")


def main():
    p = argparse.ArgumentParser(prog="auto-clicker", add_help=True)
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("stay"); sub.add_parser("return"); sub.add_parser("stop")
    sub.add_parser("status")
    sp = sub.add_parser("set-spot"); sp.add_argument("--delay", type=float, default=3.0)
    dm = sub.add_parser("daemon")
    dm.add_argument("--start-mode", choices=["idle", "stay", "return"], default="idle")
    args = p.parse_args()

    if args.cmd == "stay":
        spawn_or_signal("stay")
    elif args.cmd == "return":
        spawn_or_signal("return")
    elif args.cmd == "stop":
        cmd_stop()
    elif args.cmd == "status":
        cmd_status()
    elif args.cmd == "set-spot":
        cmd_set_spot(args.delay)
    elif args.cmd == "daemon":
        run_daemon(args.start_mode)


if __name__ == "__main__":
    main()
