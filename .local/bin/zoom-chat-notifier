#!/usr/bin/env python3
"""Zoom Team Chat -> notify-send daemon.

Holds a WebSocket to Zoom's event firehose and fires a desktop notification
on every incoming Team Chat message -- regardless of whether the Zoom web app
is focused, on another workspace, or even open. This sidesteps Chromium's
Wayland focus bug (crbug 365143359) and Zoom's "don't notify when focused"
behavior entirely, because notifications come straight from Zoom's API.

Config is read from environment (see ~/.config/zoom-chat-notifier/env):

  ZOOM_AUTH_MODE        "s2s" (Server-to-Server OAuth, needs admin) or
                        "oauth" (user-managed OAuth General app, no admin)
  ZOOM_SUBSCRIPTION_ID  the Event Subscription id from the Marketplace app
  ZOOM_CLIENT_ID        app client id
  ZOOM_CLIENT_SECRET    app client secret

  # s2s mode only:
  ZOOM_ACCOUNT_ID       your Zoom account id

  # oauth mode only (set after running `zoom-chat-notifier --authorize`):
  ZOOM_REDIRECT_URI     e.g. http://localhost:8723/callback  (must match app)
  # refresh token is stored automatically in the token file below

Optional:
  ZOOM_MY_EMAIL         your address; messages you send are skipped as echoes
  ZOOM_NOTIFY_ICON      icon name/path for the popup (default: zoom)
"""
import base64
import json
import os
import subprocess
import sys
import time
import urllib.parse
from pathlib import Path

import requests

try:
    import websockets
    from websockets.sync.client import connect as ws_connect
except ImportError:
    sys.exit("missing dependency: websockets  (pip install websockets in the venv)")

CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "zoom-chat-notifier"
TOKEN_FILE = CONFIG_DIR / "token.json"

OAUTH_TOKEN_URL = "https://zoom.us/oauth/token"
OAUTH_AUTHORIZE_URL = "https://zoom.us/oauth/authorize"
WS_BASE = "wss://ws.zoom.us/ws"
HEARTBEAT_SECS = 30
# Refresh the access token a little before its 1h expiry.
TOKEN_REFRESH_MARGIN = 5 * 60


def log(*a):
    print(f"[zoom-chat-notifier]", *a, flush=True)


def load_env_file():
    """Populate os.environ from the config env file for any keys not already
    set. Lets foreground runs work without `source`-ing; systemd's
    EnvironmentFile= still wins since those vars are already present."""
    env_path = CONFIG_DIR / "env"
    if not env_path.exists():
        return
    for line in env_path.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, val = line.partition("=")
        os.environ.setdefault(key.strip(), val.strip())


def _basic_auth_header():
    cid = os.environ["ZOOM_CLIENT_ID"]
    secret = os.environ["ZOOM_CLIENT_SECRET"]
    raw = f"{cid}:{secret}".encode()
    return "Basic " + base64.b64encode(raw).decode()


# --------------------------------------------------------------------------- #
# Token acquisition
# --------------------------------------------------------------------------- #
def get_access_token():
    """Token for the WebSocket connection.

    Per Zoom's WebSocket docs this is ALWAYS the client_credentials (app-level)
    token -- for both general and Server-to-Server apps. The token carries the
    marketplace:write:websocket_connection scope, which is what ws.zoom.us
    actually validates. (A general app additionally needs a one-time user
    authorization -- see --authorize -- so the app can see that user's events;
    but the connection itself is authenticated with this app token.)
    """
    resp = requests.post(
        OAUTH_TOKEN_URL,
        headers={"Authorization": _basic_auth_header()},
        params={"grant_type": "client_credentials"},
        timeout=30,
    )
    resp.raise_for_status()
    data = resp.json()
    return data["access_token"], time.time() + data.get("expires_in", 3600)


def _save_token(data):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    TOKEN_FILE.write_text(json.dumps(data))
    TOKEN_FILE.chmod(0o600)


# --------------------------------------------------------------------------- #
# One-time OAuth authorize (no-admin path)
# --------------------------------------------------------------------------- #
def authorize():
    """One-time OAuth bootstrap for ZOOM_AUTH_MODE=oauth.

    Zoom requires an https redirect URL, so we can't catch the callback with a
    plain local server. Instead we open the consent page; after you approve,
    the browser lands on a dead https://localhost page whose address bar holds
    `?code=...`. Paste that code (or the whole URL) back here.
    """
    redirect = os.environ.get("ZOOM_REDIRECT_URI", "https://localhost:8723/callback")

    auth_url = OAUTH_AUTHORIZE_URL + "?" + urllib.parse.urlencode({
        "response_type": "code",
        "client_id": os.environ["ZOOM_CLIENT_ID"],
        "redirect_uri": redirect,
    })
    log("open this URL in your browser and approve access:")
    print("\n  " + auth_url + "\n")
    try:
        subprocess.Popen(["xdg-open", auth_url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except FileNotFoundError:
        pass
    log("the browser will fail to load the localhost callback -- that's expected.")
    log("copy the FULL address-bar URL (or just the code=... value) and paste it below.")
    pasted = input("\ncode or redirected URL> ").strip()

    # Accept either a bare code or the full https://localhost/...?code=XXX url.
    if "code=" in pasted:
        code = urllib.parse.parse_qs(urllib.parse.urlparse(pasted).query).get("code", [None])[0]
    else:
        code = pasted
    if not code:
        sys.exit("no authorization code found in input")

    resp = requests.post(
        OAUTH_TOKEN_URL,
        headers={"Authorization": _basic_auth_header()},
        params={"grant_type": "authorization_code", "code": code, "redirect_uri": redirect},
        timeout=30,
    )
    resp.raise_for_status()
    _save_token({"refresh_token": resp.json()["refresh_token"]})
    log(f"authorized -- refresh token saved to {TOKEN_FILE}")


# --------------------------------------------------------------------------- #
# Notification formatting
# --------------------------------------------------------------------------- #
def notify(sender, text, channel=None):
    title = f"Zoom: {sender}" if not channel else f"Zoom #{channel}: {sender}"
    icon = os.environ.get("ZOOM_NOTIFY_ICON", "zoom")
    subprocess.run(
        ["notify-send", "--app-name=Zoom Chat", f"--icon={icon}",
         "--category=im.received", title, text],
        check=False,
    )


def handle_event(content):
    """content is the parsed webhook-style event dict from Zoom.

    Real chat_message.sent payload shape:
      payload.operator        -> sender's email (no display name is provided)
      payload.object.message  -> the message text
      payload.object.type     -> "to_contact" (DM) or "to_channel"
      payload.object.channel_name -> set for channel messages
    """
    if os.environ.get("ZOOM_DEBUG"):
        log("RAW EVENT:", json.dumps(content))
    if content.get("event") != "chat_message.sent":
        return
    payload = content.get("payload", {})
    obj = payload.get("object", {})

    sender_email = payload.get("operator") or obj.get("contact_email") or ""
    my_email = os.environ.get("ZOOM_MY_EMAIL", "").lower()
    if my_email and sender_email.lower() == my_email:
        return  # message you sent yourself -- don't self-notify

    # No display name in the payload; use the email's local part as the name.
    sender = sender_email.split("@")[0] if sender_email else "Zoom"
    text = obj.get("message", "")
    channel = obj.get("channel_name") if obj.get("type") == "to_channel" else None
    log(f"chat from {sender}: {text[:60]!r}")
    notify(sender, text, channel)


# --------------------------------------------------------------------------- #
# WebSocket loop
# --------------------------------------------------------------------------- #
def _subscription_id():
    """Tolerate either a bare id or a full wss://...?subscriptionId=... URL."""
    raw = os.environ["ZOOM_SUBSCRIPTION_ID"]
    if "subscriptionId=" in raw:
        return urllib.parse.parse_qs(urllib.parse.urlparse(raw).query)["subscriptionId"][0]
    return raw


def run_once():
    token, expires_at = get_access_token()
    url = f"{WS_BASE}?{urllib.parse.urlencode({'subscriptionId': _subscription_id(), 'access_token': token})}"
    log("connecting to Zoom websocket")
    with ws_connect(url, open_timeout=30) as ws:
        log("connected")
        last_hb = 0.0
        while True:
            # Reconnect before the token expires so we never get booted mid-auth.
            if time.time() > expires_at - TOKEN_REFRESH_MARGIN:
                log("token nearing expiry -- cycling connection")
                return
            now = time.time()
            if now - last_hb >= HEARTBEAT_SECS:
                ws.send(json.dumps({"module": "heartbeat"}))
                last_hb = now
            try:
                raw = ws.recv(timeout=5)
            except TimeoutError:
                continue
            try:
                frame = json.loads(raw)
            except (json.JSONDecodeError, TypeError):
                continue
            if frame.get("module") == "message":
                try:
                    handle_event(json.loads(frame["content"]))
                except (json.JSONDecodeError, KeyError) as e:
                    log("could not parse event:", e)


def run_forever():
    backoff = 1
    while True:
        try:
            run_once()
            backoff = 1  # clean cycle (token refresh) -- reset
        except KeyboardInterrupt:
            return
        except Exception as e:  # noqa: BLE001 - daemon must never die
            log(f"connection error: {e!r}; reconnecting in {backoff}s")
            time.sleep(backoff)
            backoff = min(backoff * 2, 60)


def main():
    load_env_file()
    if len(sys.argv) > 1 and sys.argv[1] == "--authorize":
        authorize()
        return
    run_forever()


if __name__ == "__main__":
    main()
