# Packages installed on top of a stock Omarchy install.
#
# RULE: every package installed on the machine gets added here, at the time it
# is installed, with a comment saying why. This file plus install.sh must be
# enough to rebuild the box. One package per line; `# comment` is ignored.
#
# RULE: do NOT list anything Omarchy already installs. Check before adding,
# rather than guessing from memory or from `pacman -Qi` install reason (Omarchy's
# installer runs pacman itself, so its packages also show as "explicitly
# installed"). The authoritative list is Omarchy's own:
#
#   grep -qxF <pkg> <(cat /usr/share/omarchy/install/*.packages | tr -d ' ')
#
# That covers ~206 packages including hyprland, ghostty, nvim, lazygit, btop,
# fastfetch, starship, gh, yay, mise, zoxide, fzf, fd, bat, eza, mpv, jq, gum,
# gnome-keyring, libsecret, herdr and ufw.

# --- Core: required for this repo to function ---
stow           # symlink farm manager for these dotfiles
omarchy-zsh    # zsh layer for Omarchy; owns ~/.zshrc and ~/.bashrc

# --- CLI tools whose config this repo carries ---
atuin          # shell history search; config + theme in home/.config/atuin
zsh-autosuggestions  # grey inline history suggestion; omarchy-zsh does not ship it
k9s            # kubernetes TUI; aliases/plugins/skin in home/.config/k9s
git-delta      # diff pager; required by core.pager in overrides.gitconfig
onefetch       # git repo stats; the repo/show_fetch functions in local.zsh are
               # defined only when it is present. Complements fastfetch (machine
               # stats), it does not replace it.

# --- Services (see SERVICES.md) ---
tailscale      # tailnet; every other service here addresses peers over it
syncthing      # Obsidian vault replication between desktop, laptop and phone
openfortivpn   # Fortinet SSL-VPN client, driven by the fortivpn bar plugin.
               # The open implementation, not Fortinet's own FortiClient.
